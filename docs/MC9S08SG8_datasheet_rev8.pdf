               <rdf:li>S08 family</rdf:li>
               <rdf:li>40 MHz S08 CPU</rdf:li>
               <rdf:li>20-TSSOP</rdf:li>
               <rdf:li>16-TSSOP</rdf:li>
            </rdf:Bag>
         </dc:subject>
      </rdf:Description>
